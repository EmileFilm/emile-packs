{
  "id": "emile/cmyk",
  "kind": "filter",
  "version": "1.0.0",
  "title": {
    "en": "CMYK",
    "zh-CN": "四色网点"
  },
  "description": {
    "en": "Four-colour process seen up close: cyan, magenta, yellow and black dots that never quite line up.",
    "zh-CN": "凑近看的四色印刷：青、品红、黄、黑四层网点，总差一点没对齐。"
  },
  "category": "print",
  "params": [
    {
      "id": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Amount",
        "zh-CN": "强度"
      }
    },
    {
      "id": "dots",
      "type": "float",
      "default": 10,
      "min": 5,
      "max": 40,
      "step": 1,
      "label": {
        "en": "Dot spacing",
        "zh-CN": "网点间距"
      }
    },
    {
      "id": "offset",
      "type": "float",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Misregistration",
        "zh-CN": "错版"
      }
    },
    {
      "id": "paper",
      "type": "color",
      "default": "#f4f0e6",
      "label": {
        "en": "Paper",
        "zh-CN": "纸"
      }
    }
  ],
  "backends": {
    "glsl": "shader.glsl"
  },
  "licence": "MIT",
  "publisher": "emile"
}
