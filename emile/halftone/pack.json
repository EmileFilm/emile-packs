{
  "id": "emile/halftone",
  "kind": "filter",
  "version": "1.0.0",
  "title": {
    "en": "Halftone",
    "zh-CN": "网点"
  },
  "description": {
    "en": "Like a photo in an old newspaper: the picture made of ink dots on paper.",
    "zh-CN": "像旧报纸上的照片：画面由纸上的油墨点组成。"
  },
  "category": "print",
  "params": [
    {
      "id": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Amount",
        "zh-CN": "强度"
      }
    },
    {
      "id": "cell",
      "type": "float",
      "default": 12,
      "min": 4,
      "max": 60,
      "step": 1,
      "label": {
        "en": "Dot spacing",
        "zh-CN": "网点间距"
      }
    },
    {
      "id": "angle",
      "type": "float",
      "default": 45,
      "min": 0,
      "max": 90,
      "step": 1,
      "label": {
        "en": "Screen angle",
        "zh-CN": "网线角度"
      }
    },
    {
      "id": "mode",
      "type": "choice",
      "default": "ink",
      "options": [
        "ink",
        "colour"
      ],
      "label": {
        "en": "Dots in",
        "zh-CN": "网点颜色"
      }
    },
    {
      "id": "ink",
      "type": "color",
      "default": "#1c1b1a",
      "label": {
        "en": "Ink",
        "zh-CN": "油墨"
      }
    },
    {
      "id": "paper",
      "type": "color",
      "default": "#f2ede3",
      "label": {
        "en": "Paper",
        "zh-CN": "纸"
      }
    }
  ],
  "backends": {
    "glsl": "shader.glsl"
  },
  "licence": "MIT",
  "publisher": "emile"
}
