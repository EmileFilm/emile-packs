{
  "id": "emile/displace",
  "kind": "filter",
  "version": "1.0.0",
  "title": {
    "en": "Displace",
    "zh-CN": "错位"
  },
  "description": {
    "en": "Bands of the picture slip sideways: something has shifted, and holds there.",
    "zh-CN": "画面的横条向旁边错开：有什么东西移了位，停在那里。"
  },
  "category": "distort",
  "params": [
    {
      "id": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Amount",
        "zh-CN": "强度"
      }
    },
    {
      "id": "slices",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "How much slips",
        "zh-CN": "错开的多少"
      }
    },
    {
      "id": "shift",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Distance",
        "zh-CN": "错开的距离"
      }
    },
    {
      "id": "split",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Colour split",
        "zh-CN": "色彩分离"
      }
    },
    {
      "id": "speed",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Speed",
        "zh-CN": "变化速度"
      }
    }
  ],
  "animated": true,
  "backends": {
    "glsl": "shader.glsl"
  },
  "licence": "MIT",
  "publisher": "emile"
}
