{
  "id": "emile/bloom",
  "kind": "filter",
  "version": "2.0.0",
  "title": {
    "en": "Bloom",
    "zh-CN": "泛光"
  },
  "description": {
    "en": "Light spills from the brightest points into the dark around them, with the warm edge film gives it.",
    "zh-CN": "最亮的地方把光漏进周围的暗处，边上带一点胶片的暖晕。"
  },
  "category": "glow",
  "params": [
    {
      "id": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Amount",
        "zh-CN": "强度"
      }
    },
    {
      "id": "threshold",
      "type": "float",
      "default": 0.8,
      "min": 0.5,
      "max": 0.95,
      "step": 0.01,
      "label": {
        "en": "Threshold",
        "zh-CN": "阈值"
      }
    },
    {
      "id": "radius",
      "type": "float",
      "default": 0.5,
      "min": 0.1,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Radius",
        "zh-CN": "范围"
      }
    },
    {
      "id": "warmth",
      "type": "float",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Warmth",
        "zh-CN": "暖度"
      }
    }
  ],
  "passes": [
    {
      "id": "bright",
      "glsl": "bright.glsl",
      "scale": 0.25
    },
    {
      "id": "tight_x",
      "glsl": "tight-x.glsl",
      "scale": 0.25
    },
    {
      "id": "tight_y",
      "glsl": "tight-y.glsl",
      "scale": 0.25
    },
    {
      "id": "blur_x",
      "glsl": "blur-x.glsl",
      "scale": 0.25
    },
    {
      "id": "blur_y",
      "glsl": "blur-y.glsl",
      "scale": 0.25
    }
  ],
  "backends": {
    "glsl": "shader.glsl"
  },
  "licence": "MIT",
  "publisher": "emile"
}
