{
  "id": "emile/vhs",
  "kind": "filter",
  "version": "1.0.0",
  "title": {
    "en": "VHS",
    "zh-CN": "录像带"
  },
  "description": {
    "en": "A tape that has been played many times: soft, colours bleeding sideways, the bottom edge tearing.",
    "zh-CN": "放过很多遍的录像带：发软，颜色向一边渗，底边在撕扯。"
  },
  "category": "film",
  "params": [
    {
      "id": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Amount",
        "zh-CN": "强度"
      }
    },
    {
      "id": "jitter",
      "type": "float",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Tracking",
        "zh-CN": "走带抖动"
      }
    },
    {
      "id": "bleed",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Colour bleed",
        "zh-CN": "颜色渗开"
      }
    },
    {
      "id": "noise",
      "type": "float",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Tape noise",
        "zh-CN": "磁带噪点"
      }
    }
  ],
  "animated": true,
  "backends": {
    "glsl": "shader.glsl"
  },
  "licence": "MIT",
  "publisher": "emile"
}
