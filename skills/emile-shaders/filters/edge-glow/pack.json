{
  "id": "emile/edge-glow",
  "kind": "filter",
  "version": "1.0.0",
  "title": {
    "en": "Edge glow",
    "zh-CN": "轮廓光"
  },
  "description": {
    "en": "The outlines of what matters light up, like a rim of light behind a subject, glowing out into the dark.",
    "zh-CN": "主体的轮廓亮起来，像身后打来的一圈轮廓光，向暗处慢慢晕开。"
  },
  "category": "glow",
  "params": [
    {
      "id": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Amount",
        "zh-CN": "强度"
      }
    },
    {
      "id": "threshold",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Which edges",
        "zh-CN": "哪些边"
      }
    },
    {
      "id": "radius",
      "type": "float",
      "default": 0.5,
      "min": 0.1,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Reach",
        "zh-CN": "光晕范围"
      }
    },
    {
      "id": "colour",
      "type": "color",
      "default": "#ffe6c7",
      "label": {
        "en": "Light",
        "zh-CN": "光的颜色"
      }
    },
    {
      "id": "dim",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": {
        "en": "Dim the picture",
        "zh-CN": "压暗画面"
      }
    }
  ],
  "passes": [
    {
      "id": "edges",
      "glsl": "edges.glsl",
      "scale": 0.5
    },
    {
      "id": "core_x",
      "glsl": "core-x.glsl",
      "scale": 0.5
    },
    {
      "id": "core_y",
      "glsl": "core-y.glsl",
      "scale": 0.5
    },
    {
      "id": "halo_x",
      "glsl": "halo-x.glsl",
      "scale": 0.25
    },
    {
      "id": "halo_y",
      "glsl": "halo-y.glsl",
      "scale": 0.25
    },
    {
      "id": "busy_x",
      "glsl": "busy-x.glsl",
      "scale": 0.125
    },
    {
      "id": "busy_y",
      "glsl": "busy-y.glsl",
      "scale": 0.125
    }
  ],
  "backends": {
    "glsl": "shader.glsl"
  },
  "licence": "MIT",
  "publisher": "emile"
}
